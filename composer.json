{
    "name": "practo/heimdall-bundle",
    "description": "Symfony2 Bundle for Practo Heimdall",
    "keywords": ["practo", "heimdall"],
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Rajaram",
            "email": "rajaram@practo.com"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "symfony/framework-bundle": ">=2.0",
        "practo/buzz-bundle": "dev-master",
        "practo/buzz": "dev-master"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/practo/Buzz.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/practo/GremoBuzzBundle.git"
        }
    ],
    "autoload": {
        "psr-0": {
            "Practo\\HeimdallBundle\\": ""
        }
    },
    "target-dir": "Practo/HeimdallBundle"
}
